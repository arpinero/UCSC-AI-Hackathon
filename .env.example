# Copy to .env (git-ignored) and adjust as needed.
# The coordination database MUST resolve to the same absolute path from
# every worktree so all six coding agents share one message bus.
FORENSICS_COORD_DB=/home/asus/forensics-agent-coordination/coordination.db

# Inference backend selection (Stage B). Only "mock" exists in Stage A.
FORENSICS_INFERENCE_BACKEND=mock
FORENSICS_MODEL_ID=alirezaaminzadeh/soc-analyst-tool-use

# Optional fallback: existing llama.cpp OpenAI-compatible server (already
# running on this machine, do not reconfigure it).
FORENSICS_LLAMACPP_BASE_URL=http://127.0.0.1:8000/v1
FORENSICS_LLAMACPP_MODEL=fdtn-ai/Foundation-Sec-8B-Instruct
