   "severity_assessment": "HIGH",
   "timeline": [
    {
     "description": "Transfer began",
     "event_type": null,
     "evidence_ids": [
      "EV-INC-2026-001-0001"
     ],
     "host_id": null,
     "timestamp": "2026-10-10T12:00:00Z"
    }
   ],
