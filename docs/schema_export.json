   ]
  },
  "InvestigationRequest": {
   "available_evidence_ids": [
    "EV-INC-2026-001-0001"
   ],
   "incident_id": "INC-2026-001",
   "question": "Was data exfiltrated from web-01, and how?",
   "request_id": "REQ-INC-2026-001-1",
   "requested_by": "containment-agent",
   "round": 1
  },
  "PositionRevision": {
