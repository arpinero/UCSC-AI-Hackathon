{
  "name": "sentinel-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel incident response workspace for the UCSC pipeline",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build --outDir web-build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "start": "node scripts/serve.mjs",
    "test": "node --test electron/*.test.cjs src/app/*.test.mjs",
    "bridge:build": "scripts/build-bridge.sh",
    "pack": "electron-builder --dir --arm64",
    "dist": "electron-builder --linux AppImage deb --arm64"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.515.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.38.2",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.2"
  },
  "author": {
    "name": "UCSC AI Hackathon team",
    "email": "sentinel@localhost"
  },
  "homepage": "https://github.com/ggml-org/llama.cpp",
  "build": {
    "appId": "org.ucsc.sentinel",
    "productName": "Sentinel",
    "executableName": "sentinel",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/*.cjs",
      "!electron/*.test.cjs",
      "web-build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/py/sentinel-server",
        "to": "sentinel-server"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Security",
      "icon": "icon.png",
      "maintainer": "UCSC AI Hackathon team <sentinel@localhost>",
      "synopsis": "Local AI incident response workspace",
      "syncDesktopName": true
    },
    "deb": {
      "afterInstall": "build-resources/after-install.sh",
      "packageName": "sentinel"
    },
    "afterPack": "build-resources/after-pack.cjs"
  },
  "desktopName": "sentinel.desktop"
}
