{
  "name": "sentinel-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser incident response workspace for the UCSC pipeline",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build --outDir web-build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "start": "node scripts/serve.mjs",
    "test": "node --test electron/*.test.cjs src/app/*.test.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^0.515.0",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.38.2",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.2"
  }
}
